# ─── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/smart-ai-chat

# ─── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=your_strong_random_secret_here
JWT_EXPIRES_IN=7d

# ─── Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# ─── Email (Nodemailer) ───────────────────────────────────────────────
MAIL_USER=your_email@gmail.com
MAIL_APP_PASSWORD=your_app_password_here

# ─── Google OAuth2 ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Metered TURN Server (optional) ──────────────────────────────────
METERED_API_KEY=your_metered_api_key_here
METERED_DOMAIN=your_app.metered.live
